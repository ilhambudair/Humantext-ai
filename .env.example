# Copy this file to `.env` for local development (`cp .env.example .env`).
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# NEVER commit a real `.env` (it is in .gitignore) and never put these values in public/.

# --- Required for AI features -------------------------------------------------------------
# Create a key at https://console.anthropic.com/  (Settings -> API keys)
ANTHROPIC_API_KEY=

# --- Optional -----------------------------------------------------------------------------
# Models the server uses. "default" = rewriting, answer review, coaching. "fast" is reserved
# for lighter calls. Check Anthropic's docs for current model names before changing.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Longest answer the model may write per request (tokens). Higher = longer rewrites, more cost.
# MAX_OUTPUT_TOKENS=4096

# Requests per visitor IP per minute (best-effort, in-memory).
# RATE_LIMIT_PER_MINUTE=20

# If set, visitors must enter this code once per browser tab before AI features work.
# Strongly recommended for a public site: it stops strangers from spending your API credit.
# AI_ACCESS_CODE=

# Extra browser origins allowed to call /api/ai (comma separated). Empty = same origin only.
# ALLOWED_ORIGINS=https://www.example.com

# Local development only
# PORT=3000
